# ─── Backend (apps/api/.env) ─────────────────────────────────────────────────

# PostgreSQL bağlantı dizesi
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentist_db"

# JWT gizli anahtar (production'da en az 32 karakter, rastgele)
JWT_SECRET="change-this-to-a-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# API sunucu portu
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV="development"

# Frontend origin (CORS için)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Frontend (apps/web/.env.local) ──────────────────────────────────────────

# Backend API adresi (tarayıcıdan erişilecek)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── AWS S3 (İleride dosya depolama için) ────────────────────────────────────
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=eu-central-1
# AWS_S3_BUCKET=dentist-files
